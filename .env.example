# Copy to `.env` next to docker-compose.yml on the server (gitignored).
# docker compose reads it automatically.

# Auth secret for admin JWT
JWT_SECRET=change-me-to-a-long-random-string

# Telegram lead notifications — shared bot @termojet_ua_bot.
# Спільна група «Termojet Sales» (форум) обслуговує ОБИДВА сайти через топіки.
# Якщо TOKEN/CHAT_ID порожні — сповіщення вимкнені.
#   TELEGRAM_BOT_TOKEN — токен бота від @BotFather
#   TELEGRAM_CHAT_ID   — група Termojet Sales = -1003809508040
#   TELEGRAM_THREAD_ID — топік 🔵 Termojet для ЗАЯВОК ФОРМ (консультація/замовлення/дилер)
#   TELEGRAM_CALLS_THREAD_ID — топік TJ Heat Pumps для ДЗВІНКІВ Binotel (колтрекінг на
#                              tjheatpump.com.ua). Порожньо → дзвінки падають у TELEGRAM_THREAD_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1003809508040
TELEGRAM_THREAD_ID=
TELEGRAM_CALLS_THREAD_ID=

# Nova Poshta — вибір міста/відділення в кошику (Етап 1).
# Ключ: кабінет НП → Налаштування → Безпека → Ключі API.
# Якщо порожній — /api/np віддає 503, поля доставки не показують підказок.
NOVA_POSHTA_API_KEY=

# Binotel — вхідні дзвінки з віртуальної АТС → лід у CRM + Telegram (backend/routes/binotel.js).
# Вебхук (API PUSH, налаштовує підтримка Binotel на своєму боці):
#   POST https://termojet.com.ua/api/webhooks/binotel
#   BINOTEL_COMPANY_ID  — ID компанії Binotel (звірка вхідних; порожньо → без перевірки)
#   BINOTEL_ALLOWED_IPS — CSV IP серверів Binotel (allowlist; порожньо → без перевірки)
#   BINOTEL_API_KEY / BINOTEL_API_SECRET — доступ до REST Binotel (запис розмови тощо), на майбутнє
BINOTEL_COMPANY_ID=
BINOTEL_ALLOWED_IPS=
BINOTEL_API_KEY=
BINOTEL_API_SECRET=
